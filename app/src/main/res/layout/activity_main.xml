<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusPillText"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_status_pill"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Collecting"
                android:textColor="@color/brand"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            style="@style/GlassPanel"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROL CHANNEL"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/heroTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0"
                        android:text="@string/cloudphone_taken_over"
                        android:textColor="@color/text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/heroSubtitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_metric_panel">

                    <TextView
                        android:id="@+id/scoreText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/brand"
                        android:textSize="34sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/MetricPanel"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RELAY"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/relayMetricText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                style="@style/MetricPanel"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ROOT"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rootMetricText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/MetricPanel"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ADB"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/adbMetricText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                style="@style/MetricPanel"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FOREGROUND"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/foregroundMetricText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/copyConnectionButton"
                style="@style/CompactButton"
                android:background="@drawable/bg_primary_button"
                android:text="@string/copy_connection"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/copyJsonButton"
                style="@style/CompactButton"
                android:background="@drawable/bg_metric_panel"
                android:text="@string/copy_json"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refreshButton"
                style="@style/CompactButton"
                android:background="@drawable/bg_metric_panel"
                android:text="@string/refresh"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/relayToggleButton"
                style="@style/CompactButton"
                android:background="@drawable/bg_metric_panel"
                android:text="Relay"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            style="@style/GlassPanel"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/InspectorSectionTitle"
                android:text="网络测试" />

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_metric_panel"
                android:hint="@string/server_hint"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/networkButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/run_network_check"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/networkText"
                style="@style/InspectorBody"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/detailsToggleButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_metric_panel"
            android:text="@string/details_show"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                style="@style/GlassPanel"
                android:orientation="vertical">

                <TextView
                    style="@style/InspectorSectionTitle"
                    android:text="总览" />

                <TextView
                    android:id="@+id/summaryText"
                    style="@style/InspectorBody" />
            </LinearLayout>

            <LinearLayout
                style="@style/GlassPanel"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/InspectorSectionTitle"
                    android:text="远程 Relay" />

                <TextView
                    android:id="@+id/relayText"
                    style="@style/InspectorMonospace" />
            </LinearLayout>

            <LinearLayout
                style="@style/GlassPanel"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/InspectorSectionTitle"
                    android:text="机器信息" />

                <TextView
                    android:id="@+id/systemText"
                    style="@style/InspectorMonospace" />
            </LinearLayout>

            <LinearLayout
                style="@style/GlassPanel"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/InspectorSectionTitle"
                    android:text="Root" />

                <TextView
                    android:id="@+id/rootText"
                    style="@style/InspectorMonospace" />
            </LinearLayout>

            <LinearLayout
                style="@style/GlassPanel"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/InspectorSectionTitle"
                    android:text="权限" />

                <TextView
                    android:id="@+id/permissionText"
                    style="@style/InspectorMonospace" />
            </LinearLayout>

            <LinearLayout
                style="@style/GlassPanel"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/InspectorSectionTitle"
                    android:text="已安装 App" />

                <TextView
                    android:id="@+id/appText"
                    style="@style/InspectorMonospace" />
            </LinearLayout>

            <LinearLayout
                style="@style/GlassPanel"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/InspectorSectionTitle"
                    android:text="JSON 报告" />

                <TextView
                    android:id="@+id/jsonText"
                    style="@style/InspectorMonospace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
